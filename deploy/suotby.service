# deploy/suotby.service — systemd-юнит Gunicorn (как у proverka.by)
# Установка: sudo cp deploy/suotby.service /etc/systemd/system/ && sudo systemctl enable --now suotby
[Unit]
Description=suot.by (Django, Gunicorn)
After=network.target postgresql.service

[Service]
User=suotby
Group=suotby
WorkingDirectory=/srv/suotby/app
EnvironmentFile=/srv/suotby/app/.env
ExecStart=/srv/suotby/venv/bin/gunicorn config.wsgi:application \
    --bind 127.0.0.1:8010 --workers 3 --timeout 30 \
    --access-logfile /var/log/suotby/access.log --error-logfile /var/log/suotby/error.log
Restart=always
RestartSec=3
# 🔐 изоляция процесса
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/srv/suotby/media /srv/suotby/private_media /var/log/suotby

[Install]
WantedBy=multi-user.target
