# .env.example — шаблон переменных окружения. Скопируйте в .env и заполните. .env в git не коммитится.

# 🔐 Обязательно на сервере: длинная случайная строка
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
DEBUG=False
DJANGO_SETTINGS_MODULE=config.settings.prod

ALLOWED_HOSTS=suot.by,www.suot.by
CSRF_TRUSTED_ORIGINS=https://suot.by
SITE_URL=https://suot.by
CANONICAL_HOST=suot.by

DATABASE_URL=postgres://suot:ПАРОЛЬ@localhost:5432/suot
# Redis для кэша (необязательно; без него — память процесса)
# CACHE_URL=redis://127.0.0.1:6379/1

MEDIA_ROOT=/srv/suotby/media
PRIVATE_MEDIA_ROOT=/srv/suotby/private_media
LOG_FILE=/var/log/suotby/app.log
SECURITY_LOG_FILE=/var/log/suotby/security.log

# 🔐 Адрес админки (не /admin/)
ADMIN_URL=upravlenie/

# Почта для уведомлений о заявках
EMAIL_HOST=smtp.yandex.ru
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=СУОТ.BY <noreply@suot.by>
LEADS_NOTIFY_EMAILS=3570911@tut.by

# Telegram-уведомления о заявках (необязательно)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Лимит заявок с одного IP
LEAD_RATE=5/h

YANDEX_METRIKA_ID=
SENTRY_DSN=
